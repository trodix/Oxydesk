[Unit]
Description=Oxydesk - PAM authentication and session startup
After=network.target systemd-logind.service

[Service]
# Only privileged component: it authenticates (PAM), starts oxydesk-agent@<user>.service and passes a
# descriptor connected to this agent to the unprivileged RDP server.
ExecStart=/usr/bin/oxydesk-authd
RuntimeDirectory=oxydesk
RuntimeDirectoryMode=0755
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
# /run/user/<uid> (agent socket) must stay accessible: no ProtectHome (it also hides /run/user).
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
