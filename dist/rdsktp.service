[Unit]
Description=RustyDesktop (rdsktp) - RDP server
Requires=rdsktp-authd.service
After=network.target rdsktp-authd.service

[Service]
# Mode, address and the other settings come from /etc/rdsktp/rdsktp.conf (and rdsktp.conf.d/*.conf); remote login by default.
ExecStart=/usr/bin/rdsktp
# Unprivileged account created by sysusers; the PAM login and the sessions are rdsktp-authd's job.
User=rdsktp
StateDirectory=rdsktp
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
