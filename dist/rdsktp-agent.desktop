[Desktop Entry]
Type=Application
Name=RustyDesktop (rdsktp-agent)
Comment=Serveur RDP : capture d'écran et injection d'entrées
Exec=/usr/bin/rdsktp-agent
NoDisplay=true
# Interfaces Wayland privilégiées que KWin accorde à /usr/bin/rdsktp-agent (ADR 004).
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1,org_kde_kwin_fake_input
