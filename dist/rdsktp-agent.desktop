[Desktop Entry]
Type=Application
Name=RustyDesktop (rdsktp-agent)
Comment=RDP server: screen capture and input injection
Exec=/usr/bin/rdsktp-agent
NoDisplay=true
# Privileged Wayland interfaces that KWin grants to /usr/bin/rdsktp-agent (ADR 004).
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1,org_kde_kwin_fake_input
