[Unit]
Description=RustyDesktop (rdsktp) - session agent for %i
After=systemd-user-sessions.service systemd-logind.service

[Service]
# Runs as the user's identity; PAMName opens a real logind session (XDG_RUNTIME_DIR, session bus).
User=%i
PAMName=rdsktp-session
SupplementaryGroups=video render
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
EnvironmentFile=-/etc/rdsktp/agent.conf
ExecStart=/usr/bin/rdsktp-agent --session kwin $RDSKTP_AGENT_ARGS
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
