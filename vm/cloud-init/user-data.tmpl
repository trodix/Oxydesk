#cloud-config
# Template: @VM_USER@ and @SSH_PUBKEY@ are replaced by vm.sh.
users:
  - name: @VM_USER@
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: [video, render, kvm]
    lock_passwd: true
    ssh_authorized_keys:
      - @SSH_PUBKEY@
ssh_pwauth: false
disable_root: true
write_files:
  - path: /usr/local/sbin/provision-rdsktp.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -u
      export DEBIAN_FRONTEND=noninteractive
      apt-get update || exit 1
      # Required packages: a failure stops provisioning (no marker).
      apt-get install -y --no-install-recommends \
        kwin-wayland plasma-workspace plasma-desktop pipewire pipewire-bin pipewire-pulse pulseaudio-utils wireplumber \
        xdg-desktop-portal xdg-desktop-portal-kde dbus-user-session libpam-systemd \
        breeze-cursor-theme libgl1-mesa-dri libegl1 libgbm1 curl jq ca-certificates || exit 1
      # Optional packages: one by one, no failure if absent.
      for p in kwin-wayland-backend-virtual libx264-164 libopenh264-8 libpam0g libpipewire-0.3-0t64; do
        apt-get install -y --no-install-recommends "$p" || echo "optional missing: $p"
      done
      loginctl enable-linger @VM_USER@ || exit 1
      touch /var/lib/rdsktp-provisioned
runcmd:
  - [ bash, -c, "/usr/local/sbin/provision-rdsktp.sh > /var/log/provision-rdsktp.log 2>&1" ]
