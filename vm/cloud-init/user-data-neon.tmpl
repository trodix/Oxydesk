#cloud-config
# Template for VM_DISTRO=neon: @VM_USER@ and @SSH_PUBKEY@ are replaced by vm.sh. An Ubuntu cloud image that becomes KDE neon
# (Unstable edition: the latest Plasma and KWin) by adding the neon archive and upgrading.
users:
  - name: @VM_USER@
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: [video, render, kvm]
    lock_passwd: true
    ssh_authorized_keys:
      - @SSH_PUBKEY@
ssh_pwauth: false
disable_root: true
write_files:
  - path: /usr/local/sbin/provision-oxydesk.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -u
      export DEBIAN_FRONTEND=noninteractive
      apt-get update || exit 1
      apt-get install -y --no-install-recommends curl gnupg ca-certificates || exit 1
      . /etc/os-release
      install -d -m 0755 /etc/apt/keyrings
      curl -fsSL https://archive.neon.kde.org/public.key | gpg --dearmor -o /etc/apt/keyrings/neon.gpg || exit 1
      echo "deb [signed-by=/etc/apt/keyrings/neon.gpg] http://archive.neon.kde.org/unstable $VERSION_CODENAME main" > /etc/apt/sources.list.d/neon.list
      # The neon packages carry a higher version than Ubuntu's: they win without pinning.
      apt-get update || exit 1
      apt-get -y dist-upgrade || exit 1
      apt-get install -y --no-install-recommends \
        kwin-wayland plasma-workspace plasma-desktop pipewire pipewire-bin pipewire-pulse pulseaudio-utils wireplumber \
        xdg-desktop-portal xdg-desktop-portal-kde dbus-user-session libpam-systemd \
        breeze-cursor-theme fuse3 libgl1-mesa-dri libegl1 libgbm1 jq || exit 1
      for p in kwin-wayland-backend-virtual libx264-164 libopenh264-8 libpam0g libpipewire-0.3-0t64 libpipewire-0.3-0; do
        apt-get install -y --no-install-recommends "$p" || echo "optional missing: $p"
      done
      # The oxydesk package depends on libkf6screen-bin | libkscreen-bin: neon has the former (and no libkscreen-bin).
      apt-get install -y --no-install-recommends libkf6screen-bin || exit 1
      kwin_wayland --version > /var/log/neon-kwin-version.txt 2>&1
      loginctl enable-linger @VM_USER@ || exit 1
      touch /var/lib/oxydesk-provisioned
runcmd:
  - [ bash, -c, "/usr/local/sbin/provision-oxydesk.sh > /var/log/provision-oxydesk.log 2>&1" ]
